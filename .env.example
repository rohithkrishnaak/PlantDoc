# No API keys or secrets are needed. All settings are optional.

# Hybrid classifier checkpoint (head + calibration + OOD feature bank). Used when present.
HYBRID_WEIGHTS=weights/plantdoc_hybrid.pth
# Fallback single-backbone checkpoint, used when no hybrid checkpoint exists.
MODEL_WEIGHTS=weights/plantdoc_effnet_b0.pth
# timm architecture for the fallback: efficientnet_b0 or mobilenetv3_large_100
MODEL_ARCH=efficientnet_b0
# Download ImageNet-pretrained weights when no checkpoint exists (demo mode)
USE_PRETRAINED_BACKBONE=true

# Quality gate pass threshold on the fuzzy quality score [0, 1]
QUALITY_PASS_THRESHOLD=0.5
# Trust threshold. Leave unset to use the value chosen on out-of-fold training
# predictions and stored in the hybrid checkpoint; set it only to override.
# TRUST_THRESHOLD=0.65
