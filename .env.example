# Path to fine-tuned classifier weights (.pth state_dict). If missing, the app
# falls back to ImageNet-pretrained backbone + untrained head (demo mode).
MODEL_WEIGHTS=weights/plantdoc_effnet_b0.pth
# timm architecture name: efficientnet_b0 or mobilenetv3_large_100
MODEL_ARCH=efficientnet_b0
# Try downloading ImageNet-pretrained backbone weights when no checkpoint exists
USE_PRETRAINED_BACKBONE=true
# Thresholds
QUALITY_PASS_THRESHOLD=0.5
TRUST_THRESHOLD=0.65
